{
  "name": "linea",
  "productName": "Linea",
  "version": "0.1.0",
  "description": "Linea",
  "author": "VegasDev",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "test": "node test/lib.test.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.vegasdev.linea",
    "productName": "Linea",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "preload-overlay.js",
      "src/**",
      "sep/**",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Linea-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "installerHeader": "build/installer-header.bmp",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "multiLanguageInstaller": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Linea",
      "runAfterFinish": true,
      "perMachine": false,
      "uninstallDisplayName": "Linea"
    },
    "portable": {
      "artifactName": "Linea-${version}-portable.exe"
    },
    "asarUnpack": [
      "sep/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "onnxruntime-node": "1.22.0"
  }
}
