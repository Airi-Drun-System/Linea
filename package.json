{
  "name": "linea",
  "productName": "Linea",
  "version": "0.1.0",
  "description": "Музыкальный плеер для ПК со словами-караоке",
  "author": "VegasDev",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "test": "node test/lib.test.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.vegasdev.linea",
    "productName": "Linea",
    "icon": "build/icon.png",
    "files": ["main.js", "preload.js", "src/**", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "artifactName": "Linea-${version}-setup.exe", "oneClick": false, "allowToChangeInstallationDirectory": true },
    "portable": { "artifactName": "Linea-${version}-portable.exe" }
  }
}
